# Docside First Look — environment
# Copy to .env.local for development. Never commit real values.

# Without these, the shell runs on the in-memory dev store
# (dev invite: http://localhost:3000/dev-preview-morris).
# Production requires them (the store fails closed otherwise).
# The tables live in the `first_look` schema of the main docside Supabase
# project (BRIEF §9 / AD-4); audio lands in the private `first-look-audio` bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4: the app.docside.ai preview handoff. Until set, the shell shows a
# local placeholder between the scenario and the debrief. Setting it flips
# the real handoff on: /workspace provisions via the docside route below,
# mints a magiclink token_hash, and redirects to APP_HANDOFF_URL/auth/confirm.
APP_HANDOFF_URL=

# Phase 4: bearer secret for docside's /api/first-look/provision route
# (invite → preview agent + Oakview clone). Must equal the value set in the
# docside Vercel project. Required whenever APP_HANDOFF_URL is set.
FIRST_LOOK_PROVISION_SECRET=

# Phase 4: the app origin allowed to POST /api/events cross-origin with
# credentials (the docside mission beacon). Exactly one origin, no paths.
# Production value: https://app.docside.ai
ALLOWED_EVENT_ORIGIN=

# Founder video (AD-5): MP4 URL + WebVTT captions. Without a URL the video
# screen shows the four-beat text fallback.
FOUNDER_VIDEO_URL=
FOUNDER_VIDEO_CAPTIONS_URL=

# Debrief Part 8 scheduling link (Calendly/Cal.com). The participant_ref is
# appended automatically — never the invite code or any token.
SCHEDULE_URL=
